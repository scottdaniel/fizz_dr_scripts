=begin
  LT.lic - Limited Treasures

  Buys from Gortik's Limited Treasures shop the moment the sale opens, then
  looks at all three silversteel stands and echoes what's on them. Lich
  version of Lycette's Genie scripts limited, limited1, limited2 and limited3.

  Start it in the Limited Treasures lounge (the room with a silversteel door
  and a door curtained with deathfiber) before Gortik opens the sale. When the
  deathfiber curtain powers down, or a customer goes through the curtained
  door, it pauses your other scripts, goes through the curtained door, buys
  what you named in the order you named it, looks at the stands, and
  unpauses your scripts. That's the fastest way in: start it any time
  before the sale and it goes the instant the curtain comes down.

  Usage:
    ;LT                          just go in and look at the stands
    ;LT mask greatcoat bookbag   buy these, in this order
    ;LT "half mask" greatcoat    quote (or comma-separate) names with spaces
    ;LT third                    buy whatever is on the third stand (or
                                 first, second); mix them: ;LT kimono third
    ;LT now mask greatcoat       only if the sale is already open (you got
                                 there late): go in and buy right away.
                                 Before the curtain comes down, this walks
                                 you into the trap.

  Good to know:
    - Don't GO before the curtain powers down. Rushing the curtained door
      early springs a trap (a volley of stones). If the script hits it anyway,
      it goes back to waiting for the curtain.
    - In a group? If your leader takes you in first, the script notices you
      arrived and starts buying.
    - Have the coins on you.
    - Keep a hand free. If both hands are full, it stows your left hand
      before the next buy.
    - It never buys the rock. Gortik: GET the rock to check how much your
      family has bought this year; he won't refund it if you buy it.
    - Each stand sells only 10, so name the one you want most first. In
      2026 all three stands were empty about 20 seconds after the curtain
      came down.
    - Since the 11-08 sale the stands are displays: LOOK ON STAND says "I
      could not find what you were referring to". LT looks on the display
      first and falls back to the stand. If it can't find either, ;LT third
      buys what the clerk is handing other people ("The sales clerk hands
      Teko a ... safos ..." => BUY SAFOS).
    - Each family can buy 5 from a stand. Bring plenty: the 2026 kimono was
      3,750,000 Kronars (375 platinum).
=end

no_pause_all

module LimitedTreasures
  LOUNGE      = 'Limited Treasures, Lounge'.freeze
  SALES_FLOOR = 'Limited Treasures, Sales Floor'.freeze
  STANDS      = { 'First' => 'stand', 'Second' => 'second stand', 'Third' => 'third stand' }.freeze

  # A line can arrive behind a prompt, like "J> Refia hands the sales clerk some coins."
  PROMPT = '(?:[^\s>]*>\s*)*'.freeze

  # "Lightning crackles over the surface of the deathfiber curtain as it powers down its defenses."
  CURTAIN_DOWN = /deathfiber curtain as it powers down its defenses/
  # "Isthu'rath'a Saar'adu Kzin went through a curtained door." Only the lounge
  # side is a plain "curtained door"; the sales floor side is a "curtained silversteel door".
  WENT_THROUGH = /^(.+?) went through a curtained door\./
  # Gortik goes through first and has been in and out before the sale, so he doesn't count
  STAFF        = /\bGortik\b/
  # The room title, when you go in or your group leader takes you in
  ARRIVED      = /\[Limited Treasures, Sales Floor\]/
  # "Malakye hastily rushes the door.  A loud *click* can be heard as his foot settles."
  # "A volley of razor sharp stones fires out from the shadows toward Malakye!"
  TRAPPED      = [/^#{PROMPT}You\b.*\brush the door/, /fires? out from the shadows toward you\b/].freeze
  # Only lines meant for you: a retry after the GO actually worked would take you back out
  GO_FAILED    = [
    /^#{PROMPT}(?:What were you referring to|I could not find|You can't go there).*/,
    /^#{PROMPT}You (?:can't|cannot|must|need|will have to|'ll have to)\b.*/
  ].freeze

  # "You decide to purchase the kimono, and pay the sales clerk 3,750,000 Kronars."
  # "The sales clerk hands you your songsilk kimono."
  # (others see "Refia hands the sales clerk some coins." / "The sales clerk hands Refia a ...")
  BOUGHT = [/sales clerk hands you\b.*/, /^#{PROMPT}You decide to purchase\b.*/].freeze
  # The clerk's answers to you that aren't a sale. "Buy what?" is the game's
  # answer for something that isn't there; the rest cover money, a full hand
  # and your family's limit without knowing their exact words.
  NOT_BOUGHT = [
    /^#{PROMPT}Buy what\?.*/,
    /^#{PROMPT}You (?:can't|cannot|need|don't|realize|must|have no|aren't|are not)\b.*/,
    /^#{PROMPT}(?:The|A) (?:sales )?clerk (?!loudly proclaims|hands (?!you\b)).*\byour?\b.*/,
    /^#{PROMPT}There (?:is|are) no\b.*/,
    /^#{PROMPT}(?:What were you referring to|I could not find)\b.*/
  ].freeze
  # A clerk who wants you to say it twice gets one more BUY
  CONFIRM = /\bconfirm\b|\bagain\b/i

  # "On the silversteel stand you see a ... and a ...", or a shop list:
  # "On the silversteel stand, you see:" followed by indented "  a ... for 10 platinum Kronars" lines
  STAND_CONTENTS = /^#{PROMPT}On (?:the|a|an) [^,:]*?,? you see:?\s*(.*)$/
  # What the stands are called, tried in this order. Since 11-08 they're
  # displays (Lycette checked); the first sales on 11-06 used stands.
  STAND_NOUNS    = %w[display stand].freeze
  # "There is nothing on there."
  STAND_EMPTY    = /^#{PROMPT}(?:There(?: is|'s)|You see|You don't see) nothing\b/i
  STAND_MISSING  = /^#{PROMPT}(?:What were you referring to|I could not find)\b/
  LIST_ITEM      = /^\s{2,}(\S.*)$/
  # "a X, a Y and a Z" => each item
  LIST_SPLIT     = /,\s*(?:and\s+)?(?=(?:a|an|some)\s)|\s+and\s+(?=(?:a|an|some)\s)/i

  # ;LT third (or "third stand") buys what's on that stand
  STAND_PICK = /\A(first|second|third)(?:\s+stand)?\z/i
  # Words that end an item's name: "kimono depicting a ...", "mask embellished with ..."
  LINK_WORDS = %w[
    of with in on from for at by to amid amidst among amongst around about under over
    beneath below behind between into onto upon across along atop inside within against
    near like that which whose bearing featuring depicting showing displaying holding
    cradling clutching framing encircling surrounding capturing flaunting
  ].freeze
  # "inlaid with", "set with": past participles without -ed
  PARTICIPLES = %w[inlaid set made wrought sewn woven hung spun strung bound dyed].freeze
  # -ing words that are the item itself, not "shimmering with ..."
  ING_NOUNS = %w[
    ring earring string painting carving clothing stocking wedding sling wing ceiling
    bedding drawing etching engraving offering setting covering lining binding
  ].freeze
  # "a pair of fingerless goldenglow glaes gloves" is bought as gloves
  COUNTED = /\A(?:pair|set) of\s+/i

  # "The sales clerk hands Teko a foggy grey oceanmist satin safos with blue gold chains draping the high collar."
  SOLD_TO_OTHER = /\AThe sales clerk hands (?!you\b)[A-Z][\w'-]* ((?:a|an|some) .+?)\.?\z/
  SALES_HOOK    = 'LT_sales'.freeze
  @sold = []
  @stand_noun = nil
  @no_stands = false
  # What follows a participle like "capturing an ..." or "flaunting a ..."
  DETERMINERS = /\A(?:a|an|the|some|its|his|her|their|two|three|four|five|several|many|numerous|\d+)\z/i

  module_function

  def strip_prompt(line)
    line.to_s.sub(/\A(?:[^\s>]*>\s*)+/, '')
  end

  # "now mask, half mask" or 'now mask "half mask"' => [true, ["mask", "half mask"]]
  def parse_args(raw)
    words = raw.to_s.strip
    now = words.match?(/\Anow\b/i)
    words = words.sub(/\Anow\b,?\s*/i, '').gsub(/\b(first|second|third)\s+stand\b/i, '\1')
    items = words.include?(',') ? words.split(',') : words.scan(/"([^"]*)"|(\S+)/).map { |quoted, word| quoted || word }
    [now, items.map { |item| item.delete('"').strip }.reject(&:empty?)]
  end

  # Is this line the sale opening (or you arriving on the sales floor)?
  def opening?(line, in_lounge)
    text = strip_prompt(line)
    return true if text =~ ARRIVED
    return false unless in_lounge
    return true if text =~ CURTAIN_DOWN

    went = text.match(WENT_THROUGH)
    !went.nil? && went[1] !~ STAFF
  end

  def in_room?(title)
    XMLData.room_title.to_s.include?(title)
  end

  def wait_for_opening
    loop do
      return if in_room?(SALES_FLOOR)
      return if opening?(get, in_room?(LOUNGE))
    end
  end

  # :inside, :trap (the curtain was still up), :lost (not in the lounge) or :failed
  def enter_sales_floor
    5.times do
      return :inside if in_room?(SALES_FLOOR)
      return :lost unless in_room?(LOUNGE)

      result = DRC.bput('go curtained door', { 'timeout' => 3 }, ARRIVED, *TRAPPED, *GO_FAILED)
      return :inside if result =~ ARRIVED
      return :trap if TRAPPED.any? { |re| result =~ re }

      pause 0.25 unless result.empty?
    end
    in_room?(SALES_FLOOR) ? :inside : :failed
  end

  def free_a_hand
    DRCI.stow_hand('left') if DRC.left_hand && DRC.right_hand
  end

  # [true, what the clerk said] or [false, why not]
  def buy(item)
    2.times do |attempt|
      return [false, "couldn't get onto the sales floor"] unless enter_sales_floor == :inside

      free_a_hand
      result = DRC.bput("buy #{item}", { 'timeout' => 5 }, *BOUGHT, *NOT_BOUGHT)
      text = strip_prompt(result)
      return [true, text] if BOUGHT.any? { |re| result =~ re }
      return [false, 'no answer from the clerk'] if text.empty?

      # One more try if the clerk wants a confirmation, or if you got carried
      # back out to the lounge (say your own GO went through after your group
      # leader had already taken you in)
      again = text =~ CONFIRM || (text =~ /Buy what/ && !in_room?(SALES_FLOOR))
      return [false, text] unless again && attempt.zero?
    end
  end

  # "third" => "third stand", or nil if it's an item name
  def stand_for(item)
    pick = item.to_s.strip.match(STAND_PICK)
    pick && STANDS[pick[1].capitalize]
  end

  def link_word?(word, following)
    word = word.downcase
    return true if LINK_WORDS.include?(word)
    return false if following.nil?

    following = following.downcase
    # "tethering a ...", "shimmering with ...", but not "earring with ..."
    if word.end_with?('ing') && !ING_NOUNS.include?(word)
      return following.match?(DETERMINERS) || LINK_WORDS.include?(following)
    end

    # "embellished with", "trimmed in", but not "bed with" or "steed with"
    participle = PARTICIPLES.include?(word) || (word.length >= 5 && word.end_with?('ed') && !word.end_with?('eed'))
    participle && LINK_WORDS.include?(following)
  end

  # Names to BUY an item by, most specific first:
  # "a belted songsilk kimono depicting a captive unicorn" => ["songsilk kimono", "kimono"]
  def buy_names(description)
    words = description.to_s.strip.sub(/\.\z/, '').sub(/\A(?:a|an|some|the)\s+/i, '').sub(COUNTED, '').split
    return [] if words.empty?

    cut = (1...words.size).find { |i| link_word?(words[i], words[i + 1]) } || words.size
    noun = words[cut - 1].delete('.,;:!?"')
    adjective = cut >= 2 ? words[cut - 2] : nil
    names = []
    names << "#{adjective} #{noun}" if adjective&.match?(/\A[a-z][a-z-]*\z/i)
    names << noun
    names.reject(&:empty?).uniq
  end

  def split_list(text)
    text.split(LIST_SPLIT).map(&:strip).reject(&:empty?)
  end

  # Remember what the clerk hands other people. Runs in a DownstreamHook, so
  # it sees lines that bput and get would otherwise take first.
  def note_sales(xml)
    text = xml.to_s.gsub(/<[^>]*>/, '').gsub('&apos;', "'").gsub('&quot;', '"')
              .gsub('&gt;', '>').gsub('&lt;', '<').gsub('&amp;', '&')
    text.each_line do |line|
      sold = strip_prompt(line.strip).match(SOLD_TO_OTHER)
      @sold << sold[1] if sold
    end
  end

  def watch_sales
    @sold = []
    DownstreamHook.add(SALES_HOOK, proc { |xml|
      begin
        note_sales(xml)
      rescue StandardError
        nil
      end
      xml
    }, persist: false)
  end

  def stop_watching_sales
    DownstreamHook.remove(SALES_HOOK)
  end

  def forget_sales
    @sold = []
  end

  # When the stand can't be read: buy what the clerk was last handing other
  # people. [true, what the clerk said, name] or [false, why not, name]
  def buy_what_others_got(wait = 3)
    timer = Time.now
    pause 0.1 while @sold.empty? && Time.now - timer < wait
    return [false, 'nobody else bought anything I could copy', nil] if @sold.empty?

    said = ''
    tried = []
    @sold.reverse.uniq.first(3).each do |description|
      buy_names(description).each do |name|
        next if tried.include?(name)

        tried << name
        bought, said = buy(name)
        return [true, said, name] if bought
        # "Buy what?" is a wrong name or sold out; money or a limit won't change
        return [false, said, name] unless said =~ /\ABuy what\?/
      end
    end
    [false, said, tried.first]
  end

  # Buy what's on a stand: [true, what the clerk said, label] or [false, why not, label]
  def buy_from(stand)
    return [false, "couldn't get onto the sales floor", nil] unless enter_sales_floor == :inside

    items, problem = stand_items(stand)
    if items.nil?
      bought, said, name = buy_what_others_got
      label = name && "#{name} (what others were buying; #{problem})"
      return [bought, bought ? said : "#{problem}; #{said}", label]
    end
    return [false, "nothing on the #{stand}", nil] if items.empty?

    names = buy_names(items.first)
    said = "can't tell what to BUY for #{items.first}"
    names.each do |name|
      bought, said = buy(name)
      return [true, said, "#{name} (#{stand})"] if bought
      # Only "Buy what?" means try the plainer name; money or a limit won't change
      break unless said =~ /\ABuy what\?/
    end
    [false, "#{said} (it's #{items.first})", names.first && "#{names.first} (#{stand})"]
  end

  # What's on a stand: [items, nil] (no items if it's empty) or [nil, why not].
  # Tries each of STAND_NOUNS ("third display", then "third stand") and
  # remembers the one that worked.
  def stand_items(stand)
    ordinal = stand.sub(/\s*stand\z/, '')
    tried = []
    nouns = @stand_noun ? [@stand_noun] : STAND_NOUNS
    nouns = [] if @no_stands
    nouns.each do |noun|
      target = [ordinal, noun].reject(&:empty?).join(' ')
      items, problem = look_once(target)
      if problem == :missing
        tried << target
        next
      end
      @stand_noun = noun if problem.nil?
      return [items, problem]
    end
    @no_stands = true unless @stand_noun
    [nil, tried.empty? ? "can't find the stands" : "no #{tried.join(' or ')} here"]
  end

  # One LOOK ON: [items, nil], [nil, :missing] or [nil, why not]
  def look_once(target)
    clear
    put "look on #{target}"
    listed = nil
    timer = Time.now
    while Time.now - timer < 4
      line = get?
      if line.nil?
        break if listed && !listed.empty? && Time.now - timer > 1
        pause 0.05
        next
      end

      if listed
        if (item = line.match(LIST_ITEM))
          listed << item[1].strip
        elsif !line.strip.empty? && !listed.empty?
          break
        end
        next
      end

      text = strip_prompt(line)
      if (seen = text.match(STAND_CONTENTS))
        rest = seen[1].strip.sub(/\.\z/, '')
        return [split_list(rest), nil] unless rest.empty?

        listed = []
      elsif text =~ STAND_EMPTY
        return [[], nil]
      elsif text =~ STAND_MISSING
        return [nil, :missing]
      end
    end
    return [listed, nil] if listed && !listed.empty?

    [nil, listed ? 'nothing listed' : "no answer to LOOK ON #{target.upcase}"]
  end

  # What's on a stand, as a sentence
  def look_on(stand)
    items, problem = stand_items(stand)
    return problem unless items

    items.empty? ? 'nothing' : items.join('; ')
  end

  def look_at_stands
    STANDS.each do |label, stand|
      DRC.message("LT: #{label} stand: #{look_on(stand)}")
    end
  end
end

LTS = LimitedTreasures

if Script.current.vars[1].to_s =~ /\A(?:help|\?)\z/i
  respond <<~HELP
    LT: buys Limited Treasures the moment the sale opens, then looks at the stands.
      ;LT                          just go in and look at the stands
      ;LT mask greatcoat bookbag   buy these, in this order
      ;LT "half mask" greatcoat    quote (or comma-separate) names with spaces
      ;LT third                    buy whatever is on the third stand (or first, second)
      ;LT now mask                sale already open? go in right away (before it opens: trap!)
  HELP
  exit
end

now, items = LTS.parse_args(Script.current.vars[0])
rocks, items = items.partition { |item| item =~ /\brock\b/i }
unless rocks.empty?
  DRC.message("LT: Not buying the rock. GET it to check your family's purchases; Gortik won't refund it.")
end
now ||= LTS.in_room?(LTS::SALES_FLOOR)

unless now || LTS.in_room?(LTS::LOUNGE)
  DRC.message("LT: You're not in the Limited Treasures lounge. I'll wait, but I only go through the curtained door from the lounge.")
end
if !items.empty? && DRC.left_hand && DRC.right_hand
  DRC.message('LT: Both your hands are full. Free one, or I stow your left hand before the first buy.')
end

wanted = items.map { |item| (stand = LTS.stand_for(item)) ? "whatever is on the #{stand}" : item }
plan = items.empty? ? 'look at the stands' : "buy #{wanted.join(', ')}, then look at the stands"
echo(now ? "Going in now to #{plan}." : "Waiting for the curtain to power down, then I'll #{plan}.")

paused = []
picks_a_stand = items.any? { |item| LTS.stand_for(item) }
LTS.watch_sales if picks_a_stand
before_dying do
  LTS.stop_watching_sales if picks_a_stand
  DRC.unpause_all_list(paused) unless paused.empty?
end

loop do
  LTS.wait_for_opening unless now
  now = false
  LTS.forget_sales
  paused = DRC.smart_pause_all if paused.empty?

  case LTS.enter_sales_floor
  when :inside
    break
  when :trap
    DRC.message('LT: The curtain was still up and the trap went off. Waiting for it to power down.')
    DRC.unpause_all_list(paused)
    paused = []
  when :lost
    DRC.message("LT: You're not in the Limited Treasures lounge, so I can't go through the curtained door.")
    exit
  else
    DRC.message("LT: Couldn't get through the curtained door. GO CURTAINED DOOR yourself, then ;LT now #{items.join(' ')}".rstrip)
    exit
  end
end

results = items.map do |item|
  stand = LTS.stand_for(item)
  next [item, *LTS.buy(item)] unless stand

  bought, said, label = LTS.buy_from(stand)
  [label || "the #{stand}", bought, said]
end
results.each do |item, bought, said|
  DRC.message("LT: #{bought ? 'Bought' : "Didn't get"} #{item}: #{said}")
end

LTS.look_at_stands if LTS.in_room?(LTS::SALES_FLOOR)

unless results.empty?
  got = results.select { |_, bought, _| bought }.map(&:first)
  missed = results.reject { |_, bought, _| bought }.map(&:first)
  summary = []
  summary << "bought #{got.join(', ')}" unless got.empty?
  summary << "didn't get #{missed.join(', ')}" unless missed.empty?
  DRC.message("LT: Done: #{summary.join('; ')}.")
end
