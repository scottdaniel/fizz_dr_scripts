=begin
  smash-shells-heal.lic

  Fork of smash-shells.lic. Instead of walking off when you get hurt, it goes
  to the healer's room, whispers to the healer, waits for the heal, and goes
  back to smashing shells. If the healer isn't there (or can't fix you), it
  heals you with your own herbs (;heal-remedy) right there, waits for them to
  work, and then walks back to the shells. When any herb ;herb-stock can buy
  is down to RESTOCK_BELOW parts, it restocks and comes back.

  "Significantly wounded" means any of:
    - bleeding
    - vitality below HEAL_BELOW_VITALITY
    - a fresh (non-scar) wound at WOUND_SEVERITY or worse, from HEALTH
    - a hand that's bleeding, even bandaged (the shell box says to clean
      your hands until it's healed)
    - the shell box says you're too injured to play

  Scars don't count: the healer can't take them, so they'd cause endless trips.

  Original documentation: https://elanthipedia.play.net/Lich_script_repository#smash-shells

  Usage:
    ;smash-shells-heal
=end

HEAL_ROOM = 16_169
HEALER = 'Azaylea'
HEAL_COMMAND = 'whisper azay meow'

HEAL_BELOW_VITALITY = 80
# 3 is "cuts and bruises"; 1-2 are minor abrasions and scratches
WOUND_SEVERITY = 3

HEAL_TIMEOUT = 60
MAX_HEAL_ATTEMPTS = 3

# Herbs heal over time (a hand wound took about 15 minutes), so wait for them
# instead of eating more
HERB_WAIT = 1200
HERB_CHECK_INTERVAL = 30
RESTOCK_BELOW = 3

# Times in a row the shell box can turn you away before the script gives up
MAX_TURNED_AWAY = 2

HANDS = ['right hand', 'left hand'].freeze

Flags.add('shell-fragments', 'shell explodes')
Flags.add('healed', 'The pain of your wounds abruptly ceases', 'but nothing else seems to happen',
          'gradually ebbs away')

settings = get_settings
trash_items = settings.hollow_eve_junk.map { |x| /\b#{x}\b/i }
hollow_eve_loot_container = settings.hollow_eve_loot_container

# The herbs herb-stock buys for your hometown. It skips ones tied to another
# town (eghmok potion is Riverhaven-only), so those can't trigger a restock.
hometown = DRC.get_town_name(settings.hometown)
BUYABLE_HERBS = get_data('healingherbs').herb_stocks[hometown].to_a
                                        .reject { |herb| herb['location'] && herb['location'] != hometown }
                                        .map { |herb| herb['name'] }
                                        .freeze

def healer_here?
  DRRoom.pcs.any? { |pc| pc.casecmp?(HEALER) }
end

def wounded_from_health?
  health = DRCH.check_health
  # Unreadable HEALTH output: play it safe and get healed
  return true unless health.captured?
  return true if health.bleeding?

  # The shell box says to clean your hands while a hand is bleeding, even
  # bandaged. Minor abrasions on a hand don't bother it.
  return true if health.bleeders.values.flatten.any? { |bleeder| HANDS.include?(bleeder.body_part) }

  health.wounds.any? { |severity, wounds| severity >= WOUND_SEVERITY && wounds.any? { |wound| !wound.scar? } }
end

def significantly_wounded?
  checkbleeding || DRStats.health < HEAL_BELOW_VITALITY || wounded_from_health?
end

def herbs_low?
  BUYABLE_HERBS.any? { |herb| DRCI.count_item_parts(herb) < RESTOCK_BELOW }
end

def restock_herbs
  DRC.message("*** Running low on herbs. Restocking with herb-stock ***")
  DRC.wait_for_script_to_complete('herb-stock')
  # herb-stock ends at the bank, where you can't take herbs out of containers
  DRCT.walk_to(HEAL_ROOM)
end

# false if you're still wounded after HERB_WAIT
def herbs_worked?
  DRC.message("*** Waiting up to #{HERB_WAIT / 60} minutes for the herbs to work ***")
  give_up = Time.now + HERB_WAIT
  while significantly_wounded?
    return false if Time.now > give_up

    pause HERB_CHECK_INTERVAL
  end
  true
end

# Heals with the herbs you carry. Herbs don't stop bleeding, so tend first.
def heal_with_herbs
  DRC.wait_for_script_to_complete('tendme') if checkbleeding
  # A second round covers herbs that ran out during the first
  2.times do
    DRC.wait_for_script_to_complete('heal-remedy')
    restock_herbs if herbs_low?
    return if herbs_worked?
  end

  DRC.message("*** Still wounded after two rounds of herbs. Stopping. ***")
  DRC.beep
  exit
end

def get_healed
  DRC.message("*** Wounded! Heading to #{HEALER} for healing ***")
  waitrt?
  DRCT.walk_to(HEAL_ROOM)

  MAX_HEAL_ATTEMPTS.times do
    unless healer_here?
      DRC.message("*** #{HEALER} isn't here. Using herbs instead ***")
      return heal_with_herbs
    end

    Flags.reset('healed')
    case DRC.bput(HEAL_COMMAND, 'You whisper to', 'You quietly whisper to', 'Who are you trying to whisper to')
    when 'Who are you trying to whisper to'
      DRC.message("*** Couldn't whisper to #{HEALER}. Using herbs instead ***")
      return heal_with_herbs
    end
    timeout = Time.now + HEAL_TIMEOUT
    pause 1 until Flags['healed'] || Time.now > timeout
    # Let any follow-up heals land before checking again
    pause 5
    return unless significantly_wounded?
  end

  DRC.message("*** Still wounded after #{MAX_HEAL_ATTEMPTS} tries with #{HEALER}. Using herbs instead ***")
  heal_with_herbs
end

before_dying do
  Flags.delete('shell-fragments')
  Flags.delete('healed')
end

DRC.message("*** Heading to grab a shell ***")

get_healed if significantly_wounded?

turned_away = 0

loop do
  get_healed if checkbleeding || DRStats.health < HEAL_BELOW_VITALITY

  DRCT.walk_to(16_236)
  until checkright || checkleft
    DRC.fix_standing
    case DRC.bput('grab box', 'roundtime', 'You are too injured', 'Perhaps that would work better', 'when you have enough coins', 'You should clean your hands')
    when 'You are too injured', 'You should clean your hands'
      turned_away += 1
      if turned_away > MAX_TURNED_AWAY
        DRC.message("*** The shell box keeps turning you away even after healing. Stopping. ***")
        DRC.beep
        exit
      end
      get_healed
      DRCT.walk_to(16_236)
    when 'when you have enough coins'
      DRC.message("*** Out of money. Getting more! ***")
      DRCT.walk_to(16_315)
      case DRC.bput('withdraw 3 platinum', 'we are not lending money at this time', 'The clerk counts out')
      when 'we are not lending money at this time'
        exit
      end
      DRCT.walk_to(16_236)
    end
    pause 1
    waitrt?
  end
  turned_away = 0

  DRCT.walk_to(16_237)

  case DRC.bput('break my shell', 'The shell', 'Break what', 'need a free hand', 'You should hold')
  when 'need a free hand', 'Break what'
    DRCI.stow_hands
  end
  pause

  [DRC.left_hand, DRC.right_hand]
    .compact
    .each do |in_hand|
    if in_hand
      case in_hand
      when *trash_items
        DRC.bput("put my #{in_hand} in bucket", 'You put', 'You drop', 'What were', 'Stow what?')
      else
        # Coil rope so we can store it
        if /\brope\b/ =~ in_hand
          fput("coil my #{in_hand}")
        end
        if !DRCI.put_away_item?(in_hand, hollow_eve_loot_container)
          DRC.message("*** The item is either too big to fit or no more room in the container(s)! ***")
          DRC.beep
          exit
        end
      end
    end
  end

  waitrt?
  next unless Flags['shell-fragments']

  pause 4
  DRC.wait_for_script_to_complete('tendme')
  Flags.reset('shell-fragments')
  get_healed if significantly_wounded?
end
