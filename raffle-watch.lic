=begin
  raffle-watch.lic

  Plays the festival raffle for you and reports to the Familiar window:
    - each winner as their name goes up on the result board
    - if it's you: a beep, a big notice, and PUT TICKET ON COUNTER to claim
    - if the drawing ends without you: PUT TICKET IN BUCKET
    - when picks open for the next raffle: GET TICKET FROM COUNTER

  Stand in the raffle room with a free hand. It assumes you're holding a
  ticket when you start it. If your ticket isn't in your hands when it's time
  to put it somewhere, it gets it out of your containers first. Keeps running
  until you ;kill it, or give it "once" to stop after the next drawing
  (it still bins or claims that ticket, but doesn't get a new one).

  Usage:
    ;raffle-watch
    ;raffle-watch once
=end

no_pause_all
no_kill_all

once = Script.current.vars[1].to_s.casecmp?('once')
name = checkname

PICKS_OPEN = /Raffle picks are now available for the next drawing!/
DRAWING_STARTED = /Raffle picks are closed for this drawing!/
PRIZE_CALLED = /The winning ticket number for the \*?(\w+)\*? prize is/
NAME_ON_BOARD = /^(\w+)'s name appears on the result board!/
DRAWING_OVER = /Congratulations to all our winners!/
NOT_A_WINNER = /examines your ticket but shakes (?:her|his) head/
GOT_TICKET = /^You (?:tear off|get) .*raffle ticket/
DROPPED_TICKET = /^You (?:drop|put) .*raffle ticket/
ATTENDANT = /Attendant \w+/
# "What were you referring to?" / "I don't understand what you're referring to."
NOT_FOUND = /referring to/
NOT_FOUND_LINE = /.*referring to.*/

def to_familiar(text)
  safe = text.gsub('&', '&amp;').gsub('<', '&lt;').gsub('>', '&gt;')
  _respond("<pushStream id=\"familiar\" ifClosedStyle=\"watching\"/>[raffle] #{safe}\n<popStream/>\n")
end

# Puts your ticket somewhere. If it isn't in your hands, gets it out of your
# containers and tries once more. Returns the game's response ('' if none).
def put_ticket(command, *matches)
  result = DRC.bput(command, *matches, NOT_FOUND_LINE)
  return result unless result =~ NOT_FOUND
  return result unless DRCI.get_item?('raffle ticket')

  DRC.bput(command, *matches, NOT_FOUND_LINE)
end

# Returns true once the attendant has taken your winning ticket
def claim_prize
  result = put_ticket('put ticket on counter', /.*your ticket.*/, /.*hands you.*/)
  if result.empty? || result =~ NOT_FOUND
    to_familiar("Couldn't put your winning ticket on the counter! PUT TICKET ON COUNTER yourself.")
    DRC.beep
    return false
  end

  to_familiar(result)
  true
end

def trash_ticket
  result = put_ticket('put ticket in bucket', /^You drop .*raffle ticket.*/)
  return if result =~ /^You drop/

  to_familiar("Couldn't put your ticket in the bucket: #{result.empty? ? 'no response' : result}")
end

# Returns true if you tore off a ticket
def get_ticket
  if DRC.left_hand && DRC.right_hand
    to_familiar('Your hands are full, so no ticket for this drawing. Free a hand and GET TICKET FROM COUNTER.')
    return false
  end

  result = DRC.bput('get ticket from counter', /^You tear off .*raffle ticket.*/, /^You need a free hand.*/, NOT_FOUND_LINE)
  if result =~ /^You tear off/
    to_familiar(result)
    return true
  end

  to_familiar("Couldn't get a ticket: #{result.empty? ? 'no response' : result}")
  false
end

entered = true
prize = nil
won = []
claimed = false

to_familiar("Watching the raffle for #{name}.")
echo "raffle-watch started for #{name}. Results go to the Familiar window."

loop do
  line = get
  next if line.nil? || line.empty?

  case line
  when PICKS_OPEN
    entered = get_ticket
  when DRAWING_STARTED
    prize = nil
    won = []
    claimed = false
    to_familiar(line) if entered
  when PRIZE_CALLED
    prize = Regexp.last_match(1)
  when NAME_ON_BOARD
    winner = Regexp.last_match(1)
    if winner.casecmp?(name)
      won << (prize || 'a')
      to_familiar("*** YOU WON the #{prize || 'a'} prize! ***")
      DRC.beep
      claimed = claim_prize
    elsif entered
      to_familiar("#{prize || '?'} prize: #{winner}")
    end
  when DRAWING_OVER
    if !won.empty?
      to_familiar("Drawing over. You won the #{won.join(', ')} prize!")
      # The attendant asks winners to claim now, so give it one more go
      claim_prize unless claimed
    elsif entered
      to_familiar("Drawing over. You didn't win this one.")
      trash_ticket
    end
    entered = false
    exit if once
  when NOT_A_WINNER
    to_familiar(line)
  when GOT_TICKET
    entered = true
  when DROPPED_TICKET
    entered = false
  end

  # The attendant handing over your prize, or anything else she says about you
  to_familiar(line) if line =~ ATTENDANT && line =~ /\b#{name}'s\b|your ticket|hands you/i && line !~ NOT_A_WINNER
end
