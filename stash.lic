=begin
  stash.lic

  Puts things from your containers in your vault at your hometown's Carousel
  (Crossing: ;go2 8285, through an arch, PULL LEVER, GO DOOR, OPEN VAULT),
  then closes it and leaves you in the Carousel. ;unstash gets it all back.

  Usage:
    ;stash crafting        # forging, shaping, enchanting, outfitting and alchemy gear and materials
    ;stash forging         # just forging gear and materials
    ;stash shaping         # just shaping gear and materials
    ;stash enchanting      # just enchanting gear and materials
    ;stash outfitting      # just outfitting gear and materials
    ;stash alchemy         # just alchemy gear
    ;stash materials       # just the materials, no gear: ingots, ore, lumber, deeds, stacks, stone, beads, cloth...
    ;stash materials forging   # just one discipline's materials (shaping, enchanting, outfitting too)
    ;stash weapons         # the weapons in your yaml's weapon_training, for when you're not hunting
    ;stash extras          # just your extras
    ;stash all             # crafting gear and materials plus your extras
    ;stash add <item>      # add something to your extras (taps it first to check the name)
    ;stash remove <item>   # take something off your extras
    ;stash list            # show your gear, your extras, and what's stashed right now

  Crafting gear is forging_tools, shaping_tools, enchanting_tools,
  outfitting_tools and alchemy_tools from your yaml, plus the books, logbooks
  and supplies in SUPPLIES below. It comes out of your crafting_container,
  one of each.

  Crafting materials are whatever LOOK IN shows in your crafting_container
  and storage_containers that MATERIALS below says a discipline uses: ingots,
  bars and ore for forging, lumber, deeds, bone stacks and stone for shaping,
  beads for enchanting, leather, cloth and dyes for outfitting, and so on.
  Every one gets stashed, from whichever container it's in. A weapon harness
  isn't looked in: only weapons are tied to it.

  Weapons are the ones named in your yaml's weapon_training. Each comes out
  of wherever your yaml's gear list says it's kept, the way combat-trainer
  gets it: taken off if you wear it, off its harness, out of its sheath or
  container. ;unstash weapons puts them back the way combat-trainer does
  after a hunt (worn again if your standard gear set wears it).

  Extras are your own list, kept in EXTRAS. It starts as codex, textbook and
  contract. Every one of them you're carrying gets stashed, from whichever
  container it's in.

  If the vault is full, the rest stays where it is. If rent is due, nothing
  happens: pay at the Carousel desk first (GO DESK, 5,000 Kronars for 30
  days).

  What went in is written to STASHED so ;unstash gets back exactly those
  things and puts them back where they came from. Each one is written down
  with what it's for (forging, shaping, enchanting, outfitting, alchemy,
  weapons or extras), so
  ;unstash forging and the like get back just that.
=end

# What's stashed right now. Shared with unstash.
STASHED = File.join(DATA_DIR, XMLData.game, Char.name, 'stash.yaml')
# Your extras, changed with ;stash add and ;stash remove
EXTRAS = File.join(DATA_DIR, XMLData.game, Char.name, 'stash-extras.yaml')
DEFAULT_EXTRAS = %w[codex textbook contract].freeze

# Crafting gear besides each discipline's tools from your yaml
SUPPLIES = {
  'forging' => [
    'weapon.book', # book of apprentice weaponsmithing instructions
    'forging logbook',
    'oil', # flask of oil
    'flux' # borax flux
  ],
  'shaping' => [
    'shap.book', # book of apprentice shaping instructions
    'engineering logbook'
  ],
  'enchanting' => [
    'artificing book', # book of apprentice artificing instructions
    'enchanting logbook',
    'fount' # fragile rough mana fount
  ],
  # Bought 11/9/2026
  'outfitting' => [
    'tailoring book', # book of apprentice tailoring instructions
    'outfitting logbook'
  ],
  # Bought 11/9/2026. remedy.lic gets the book as "remed book".
  'alchemy' => [
    'remed.book', # book of apprentice remedies instructions
    'alchemy logbook'
  ]
}.freeze
# ;stash crafting does all of these
DISCIPLINES = SUPPLIES.keys.freeze

# What each discipline crafts from, matched against the item names LOOK IN
# shows ("huge pewter bar", "heavy wool cloth"). Every match gets stashed.
MATERIALS = {
  'forging'    => {
    'ingots'     => /\bingot$/i,
    'nuggets'    => /\bnugget$/i,
    'metal bars' => /\bbar$/i,
    # Mined ore: a size from Elanthipedia's Mining page, then the metal
    # ("large muracite fragment", "massive quelium lump")
    'metal ore'  => /\b(?:tiny|small|medium|large|huge|massive|enormous|gargantuan) \S+ (?:fragment|lump)$/i
  },
  'shaping'    => {
    'lumber'       => /\blumber$/i,
    'lumber deeds' => /\b(?:stick|branch|limb|log) \S+ deed$/i, # log walnut deed; sizes from clean-lumber.lic
    'bone stacks'  => /\bstack$/i,
    'stone deeds'  => /\b(?:pebble|stone|rock|boulder) \S+ deed$/i, # rock quartzite deed, for carving
    # Loose stone, by its size noun: "white mocha stone". Not starstone or
    # runestone, which have no word break before "stone".
    'stones'       => /\b(?:pebble|stone|small rock|large rock|boulder)$/i
  },
  'enchanting' => {
    'sigil-scrolls' => /\bsigil-scroll$/i,
    # A stone, bone or wood bead is a base for trinkets and foci
    'beads'         => /\bbead$/i
  },
  'outfitting' => {
    'leather' => /\bleather$/i,
    # The fabrics sorter's base-sorting.yaml counts as crafting, plus felt;
    # not chamois or cleaning cloth
    'cloth'   => /\b(?:burlap|cotton|felt|linen|silk|wool) cloth$/i,
    'yarn'    => /\byarn$/i,
    'thread'  => /\bthread$/i,
    'dyes'    => /\bdye$/i
  },
  # Herbs stay in your remedy_container
  'alchemy'    => {}
}.freeze

# storage_containers that can't hold materials, so aren't looked in
NOT_LOOKED_IN = /\bharness\b/i

# Getting in and out of the vault, as Fizzlestiks did it at the Crossing
# Carousel on 2026-11-07 and 11-08. Plain GO ARCH is the platinum arch, which
# the attendant blocks ("Sorry, but access to that arch is restricted."), so
# it isn't tried. The blackwood, ironwood and rosewood arches all work
# ("The Dwarven attendant escorts you through the ironwood arch."). A busy
# booth: 'The attendant steps in front of the blackwood arch.  "Sban is using
# that booth," he says.'
ARCHES = ['go blackwood arch', 'go ironwood arch', 'go rosewood arch'].freeze
ARCH_IN = /escorts you through/
RENT_DUE = /\brent\b/i
ARCH_RESTRICTED = /access to that arch is restricted/
ARCH_BUSY = /is using that booth|blocks|someone|using|Sorry/
LEVER_PULLED = /door pops open/
VAULT_OPENED = [/^The vault opens/, /already open/i].freeze
CHAMBER = /Chamber/

# bput returns only the matched text, so these match the whole line
GET_SUCCESS = [/^You get .*/, /^You pick up .*/].freeze
PUT_SUCCESS = [/^You put .*/].freeze
TAP_SUCCESS = [/^You tap\s(?!into).*/, /^As you tap .*/, /^You (?:thump|drum) your finger.*/].freeze
NOT_FOUND = [/^What were you referring to/, /^I could not find/, /^I don't know what you are referring to/].freeze
# The vault's full message isn't known yet, so these are guesses
VAULT_FULL = [/no room/i, /isn't any more room/i, /\bfull\b/i, /too many/i, /maximum/i].freeze
# Just this item won't go in
PUT_FAILURE = [/^You can't/, /^You must/, /^Weirdly, you can't/, /is too .* to (fit|hold)/, /to fit in the/].freeze

# "You get a paper-wrapped textbook from inside your grey rucksack."
GET_NAME = /^You (?:get|pick up) (?:a|an|some|the|your) (.+?)(?: from .*)?\.$/
GET_SOURCE = /from inside your (.+?)\.$/
# "You tap some bundling rope inside your grey rucksack." or "... that you are holding."
TAP_NAME = /^You tap (?:a|an|some|the|your) (.+?)(?: inside your (.+?)| that you are (\w+))?\.$/

def load_yaml(path, default)
  File.exist?(path) ? YAML.safe_load(File.read(path)) || default : default
end

def save_yaml(path, data)
  FileUtils.mkdir_p(File.dirname(path))
  File.write(path, data.to_yaml)
end

def load_extras
  load_yaml(EXTRAS, DEFAULT_EXTRAS).dup
end

def hands_empty?
  DRC.right_hand.nil? && DRC.left_hand.nil?
end

# The hand display and room title can lag the game text by a moment
def settle
  10.times do
    return true if yield

    pause 0.1
  end
  false
end

def in_chamber?
  [XMLData.room_title, XMLData.room_name].any? { |title| title.to_s =~ CHAMBER }
end

# Walks to the hometown's Carousel and opens your vault. Remembers how far it
# got in @vault_steps so leave_vault can undo it. Says why and returns false
# if it can't.
def open_vault(settings)
  @vault_steps = []
  room = get_data('town')[settings.hometown]&.dig('vault', 'id')
  unless room
    DRC.message("stash: no vault listed for your hometown, #{settings.hometown}.")
    return false
  end
  unless DRCT.walk_to(room)
    DRC.message("stash: couldn't walk to the Carousel (room #{room}).")
    return false
  end
  return false unless enter_booth

  unless DRC.bput('pull lever', LEVER_PULLED, *NOT_FOUND, /^You can't/) =~ LEVER_PULLED
    DRC.message("stash: pulling the lever didn't open the door.")
    return false
  end

  DRC.bput('go door', /.+/)
  unless settle { in_chamber? }
    DRC.message("stash: GO DOOR didn't reach the Carousel Chamber. Room: #{XMLData.room_title.inspect}")
    return false
  end
  @vault_steps << :chamber

  result = DRC.bput('open vault', *VAULT_OPENED, RENT_DUE, *NOT_FOUND, /^You can't/)
  unless VAULT_OPENED.any? { |pattern| result =~ pattern }
    DRC.message("stash: the vault didn't open: #{result.empty? ? 'no reply' : result}")
    return false
  end
  @vault_steps << :open
  true
end

# Through the first arch whose booth is free, waiting a while if all are in use
def enter_booth
  6.times do
    ARCHES.each do |arch|
      result = DRC.bput(arch, ARCH_IN, RENT_DUE, ARCH_RESTRICTED, ARCH_BUSY, *NOT_FOUND)
      if result =~ ARCH_IN
        @vault_steps << :booth
        return true
      end
      if result =~ RENT_DUE
        DRC.message('stash: vault rent is due. Pay it at the Carousel desk (GO DESK), then try again.')
        return false
      end
      # Not in the Carousel any more (say, someone went through an arch by hand)
      if NOT_FOUND.any? { |pattern| result =~ pattern }
        DRC.message("stash: there's no #{arch.split[1]} arch here, so stopping.")
        return false
      end
    end
    DRC.message('stash: every booth is busy. Waiting 10 seconds.')
    pause 10
  end
  DRC.message('stash: gave up waiting for a free booth.')
  false
end

# Closes the vault and goes back out to the Carousel, as far as open_vault got
def leave_vault
  steps = @vault_steps.to_a
  DRC.bput('close vault', /^You close the vault/, /already closed/i, /isn't open/i, *NOT_FOUND) if steps.include?(:open)
  DRC.bput('go door', /.+/) if steps.include?(:chamber)
  DRC.bput('go arch', /door slams closed/, /.+/) if steps.include?(:booth)
  @vault_steps = []
end

# All your crafting gear, as item => the disciplines it's for, in yaml order.
# Something two disciplines use comes back with ;unstash for either one.
def crafting_gear(settings)
  tools = {
    'forging'    => settings.forging_tools.to_a,
    'shaping'    => settings.shaping_tools.to_a,
    'enchanting' => settings.enchanting_tools.to_a,
    'outfitting' => settings.outfitting_tools.to_a,
    'alchemy'    => settings.alchemy_tools.to_a
  }
  DISCIPLINES.each_with_object({}) do |discipline, gear|
    (tools[discipline] + SUPPLIES[discipline]).each { |item| gear[item] = gear.fetch(item, []) | [discipline] }
  end
end

# The part of the crafting gear these disciplines use
def gear_for(disciplines, gear)
  gear.select { |_item, used_for| (used_for & disciplines).any? }
end

# Your extras that aren't crafting gear, as item => ['extras']
def extras_for(gear)
  (load_extras - gear.keys).to_h { |item| [item, ['extras']] }
end

# The disciplines whose MATERIALS match this item name
def material_uses(name)
  DISCIPLINES.select { |discipline| MATERIALS[discipline].values.any? { |pattern| name =~ pattern } }
end

# The crafting materials these disciplines use that LOOK IN shows in your
# containers, as [what to GET, what it's for, container, name LOOK showed].
# GET only takes the one word right before the noun, so "huge pewter bar" is
# fetched as "pewter bar".
def find_materials(disciplines, settings)
  return [] if disciplines.empty?

  containers = ([settings.crafting_container] + settings.storage_containers.to_a).compact.uniq
  # A harness answers LOOK IN with "You have ... secured to your harness.",
  # which DRCI doesn't know, so it waited 15 seconds for nothing on every
  # stash (2026-11-09). Only weapons go on one.
  containers.reject! { |container| container =~ NOT_LOOKED_IN }
  containers.flat_map do |container|
    DRCI.get_item_list(container, 'look').to_a.filter_map do |name|
      used_for = material_uses(name)
      [name.split.last(2).join(' '), used_for, container, name] if (used_for & disciplines).any?
    end
  end
end

# What ;unstash asks the vault for. A bare noun gets the word before it in
# the name, so "codex" comes back as "kidskin codex" and not some other codex
# already in the vault. Not for "flask of grey oil": whether GREY OIL works
# there is unknown, so that stays OIL.
def vault_address(item, name)
  return item if item.include?(' ') || name.nil?

  words = name.split
  index = words.rindex(item)
  return item unless index&.positive? && !words[0...index].include?('of')

  adjective = words[index - 1]
  %w[a an some the].include?(adjective) ? item : "#{adjective} #{item}"
end

# Gets the item into your hand, from the container if one is given. Returns
# the GET line, or nil if you don't have one.
def take_out(item, container)
  from = container ? " from my #{container}" : ''
  result = DRC.bput("get my #{item}#{from}", *GET_SUCCESS, *NOT_FOUND, *DRCI::GET_ITEM_FAILURE_PATTERNS)
  result if GET_SUCCESS.any? { |pattern| result =~ pattern } && settle { !hands_empty? }
end

# Returns :put, :full, or :failed
def put_in_vault(item)
  result = DRC.bput("put my #{item} in vault", *PUT_SUCCESS, *VAULT_FULL, *NOT_FOUND, *PUT_FAILURE)
  return :put if PUT_SUCCESS.any? { |pattern| result =~ pattern } && settle { hands_empty? }
  return :full if VAULT_FULL.any? { |pattern| result =~ pattern }

  :failed
end

# Back where it came from, then the crafting container, then plain STOW
def put_back(item, *places)
  return if DRCI.put_away_item?(item, places.compact.uniq + [nil])

  DRC.message("stash: couldn't put #{item} back. It's still in your hand.")
  exit
end

# gear comes out of the crafting container, one of each; extras come from
# anywhere, every one you have. Both are item => what it's for. Then every
# crafting material the material_disciplines use, from wherever it is.
def stash_items(gear, extras, settings, material_disciplines = [])
  container = settings.crafting_container
  unless hands_empty?
    DRC.message('stash: empty your hands first.')
    exit
  end

  jobs = gear.map { |item, used_for| [item, used_for, container, true] } +
         find_materials(material_disciplines, settings).map { |item, used_for, from, seen_as| [item, used_for, from, true, seen_as] } +
         extras.map { |item, used_for| [item, used_for, nil, false] }
  # ;stash materials when you carry none: no trip to the vault for nothing
  if jobs.empty?
    DRC.message('stash: nothing to stash.')
    return
  end

  stashed = load_yaml(STASHED, [])
  put = []
  left_over = []
  missed = []
  failed = []
  full = false

  begin
    exit unless open_vault(settings)

    jobs.each do |item, used_for, take_from, just_one, seen_as|
      if full
        left_over << item if DRCI.exists?(item, take_from)
        next
      end

      got_any = false
      while (line = take_out(item, take_from))
        got_any = true
        from = line[GET_SOURCE, 1] || take_from
        name = line[GET_NAME, 1]
        case put_in_vault(item)
        when :put
          put << item
          # A copy of used_for each time: two codices sharing one array would
          # be written as a YAML alias, which safe_load refuses to read back
          stashed << { 'item' => vault_address(item, name), 'name' => name, 'from' => from, 'for' => used_for.dup }
          save_yaml(STASHED, stashed)
          break if just_one
        when :full
          full = true
          left_over << item
          put_back(item, from, container)
          break
        else
          failed << (name || item)
          put_back(item, from, container)
          break
        end
      end
      missed << "#{seen_as} (#{take_from})" if seen_as && !got_any
    end
  ensure
    leave_vault
  end

  DRC.message("stash: put in your vault: #{put.join(', ')}") unless put.empty?
  DRC.message('stash: nothing to stash.') if put.empty? && left_over.empty? && missed.empty? && failed.empty?
  DRC.message("stash: the vault is full, kept: #{left_over.uniq.join(', ')}") unless left_over.empty?
  DRC.message("stash: the vault wouldn't take these, kept them: #{failed.join(', ')}") unless failed.empty?
  DRC.message("stash: saw these but GET couldn't pick them up: #{missed.join(', ')}") unless missed.empty?
end

# The weapons in your yaml's weapon_training, each once (the gilt dagger is
# both Small Edged and Offhand Weapon), as [weapon_training name, gear item].
# One that isn't in your yaml's gear list is left out: EquipmentManager only
# knows where gear-list things are kept.
def weapons_to_stash(settings, manager)
  settings.weapon_training.to_h.values.compact.uniq.filter_map do |description|
    weapon = manager.item_by_desc(description)
    DRC.message("stash: #{description} isn't in your yaml's gear list, so it stays where it is.") unless weapon
    [description, weapon] if weapon
  end
end

# Puts a weapon in hand back where it's kept, as after a hunt: worn again if
# your standard gear set wears it, else on its harness, in its container,
# or STOWed (into the sheath, for the cutlass and broadsword)
def return_weapon(manager)
  return if manager.return_held_gear && settle { hands_empty? }

  DRC.message("stash: couldn't put #{DRC.right_hand || DRC.left_hand} back. It's still in your hand.")
  exit
end

# ;stash weapons, for when you're not hunting. Each weapon comes out of
# wherever it's kept, the way combat-trainer gets it: taken off if you wear
# it (the voulge, the knuckles), off its harness (the throwing club, the
# staff), out of its sheath or container. ;unstash weapons puts each back the
# same way combat-trainer does after a hunt.
def stash_weapons(settings)
  unless hands_empty?
    DRC.message('stash: empty your hands first.')
    exit
  end

  manager = EquipmentManager.new(settings)
  weapons = weapons_to_stash(settings, manager)
  if weapons.empty?
    DRC.message('stash: no weapons to stash: your yaml has none in weapon_training.')
    return
  end

  stashed = load_yaml(STASHED, [])
  put = []
  not_found = []
  kept = []
  full = false

  begin
    exit unless open_vault(settings)

    weapons.each do |description, weapon|
      if full
        kept << description
        next
      end
      unless manager.get_item?(weapon) && settle { !hands_empty? }
        not_found << description
        next
      end

      result = put_in_vault(weapon.short_name)
      if result == :put
        put << description
        # No name: the GET line from the vault gives the full description,
        # which the yaml doesn't have, so ;unstash takes the weapon by
        # short_name without checking it
        stashed << { 'item' => weapon.short_name, 'name' => nil, 'from' => 'gear', 'for' => ['weapons'] }
        save_yaml(STASHED, stashed)
      else
        full = result == :full
        kept << description
        return_weapon(manager)
      end
    end
  ensure
    leave_vault
  end

  DRC.message("stash: put in your vault: #{put.join(', ')}") unless put.empty?
  DRC.message("stash: #{full ? 'the vault is full, kept' : "the vault wouldn't take these, kept them"}: #{kept.join(', ')}") unless kept.empty?
  DRC.message("stash: couldn't find these to stash: #{not_found.join(', ')}") unless not_found.empty?
  DRC.message('stash: ;unstash weapons gets them back before you hunt.') unless put.empty?
end

def add_extra(item)
  if item.empty?
    DRC.message('stash: add what? For example: ;stash add gem pouch')
    return
  end

  extras = load_extras
  if extras.include?(item)
    DRC.message("stash: #{item} is already on your extras.")
    return
  end

  result = DRC.bput("tap my #{item}", *TAP_SUCCESS, *NOT_FOUND)
  unless TAP_SUCCESS.any? { |pattern| result =~ pattern }
    DRC.message("stash: TAP couldn't find a \"#{item}\" on you, so it's not added. Check the name and try again.")
    return
  end

  name, container, state = result.match(TAP_NAME)&.captures
  if state == 'wearing'
    DRC.message("stash: you're wearing the #{name}. Stash only takes things you carry, so it's not added.")
    return
  end

  extras << item
  save_yaml(EXTRAS, extras)
  where = if container then ", in your #{container}"
          elsif state then ", that you're #{state}"
          end
  DRC.message("stash: added #{item} (#{name || result}#{where}). ;stash extras or ;stash all will stash every one you have.")
end

def remove_extra(item)
  extras = load_extras
  if extras.delete(item)
    save_yaml(EXTRAS, extras)
    DRC.message("stash: removed #{item}. Extras now: #{extras.empty? ? 'none' : extras.join(', ')}")
  else
    DRC.message("stash: #{item.empty? ? 'remove what?' : "#{item} isn't on your extras."} Extras: #{extras.join(', ')}")
  end
end

def show_list(gear, settings)
  DISCIPLINES.each do |discipline|
    tools = gear_for([discipline], gear).keys
    materials = MATERIALS[discipline].keys
    DRC.message("stash: #{discipline} (;stash #{discipline}): #{tools.empty? ? 'no gear' : tools.join(', ')}" \
                "#{", plus any #{materials.join(', ')}" unless materials.empty?}")
  end
  weapons = settings.weapon_training.to_h.values.compact.uniq
  DRC.message("stash: weapons (;stash weapons): #{weapons.empty? ? 'none' : weapons.join(', ')}")
  extras = load_extras
  DRC.message("stash: extras (;stash extras): #{extras.empty? ? 'none' : extras.join(', ')}")

  stashed = load_yaml(STASHED, [])
  if stashed.empty?
    DRC.message('stash: nothing is stashed right now.')
    return
  end

  stashed.group_by { |entry| entry['for'].to_a.join('/') }.each do |used_for, entries|
    names = entries.map { |entry| entry['name'] || entry['item'] }
    DRC.message("stash: in your vault#{" for #{used_for}" unless used_for.empty?}: #{names.join(', ')}")
  end
  DRC.message('stash: ;unstash gets it all back, or ;unstash forging, shaping, enchanting, outfitting, alchemy, crafting, weapons or extras gets just that.')
end

settings = get_settings
command = Script.current.vars[1].to_s.downcase
item = Script.current.vars[2..].to_a.compact.join(' ').downcase.strip
gear = crafting_gear(settings)

case command
when 'crafting'
  stash_items(gear, {}, settings, DISCIPLINES)
when *DISCIPLINES
  stash_items(gear_for([command], gear), {}, settings, [command])
when 'materials', 'material'
  # Just the materials, the heavy part, leaving the tools where they are
  if item.empty?
    stash_items({}, {}, settings, DISCIPLINES)
  elsif DISCIPLINES.include?(item) && !MATERIALS[item].empty?
    stash_items({}, {}, settings, [item])
  else
    DRC.message("stash: #{item} has no materials. Use ;stash materials, or ;stash materials #{DISCIPLINES.reject { |discipline| MATERIALS[discipline].empty? }.join(', ')}.")
  end
when 'weapons', 'weapon'
  stash_weapons(settings)
when 'extras'
  stash_items({}, extras_for(gear), settings)
when 'all'
  stash_items(gear, extras_for(gear), settings, DISCIPLINES)
when 'add'
  add_extra(item)
when 'remove'
  remove_extra(item)
when 'list'
  show_list(gear, settings)
else
  DRC.message('stash: use ;stash crafting, forging, shaping, enchanting, outfitting, alchemy, materials, weapons, extras, all, add <item>, remove <item>, or list.')
end
